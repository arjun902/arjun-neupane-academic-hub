# Copy to .env.local. Public Supabase keys are designed for browsers; RLS protects data.
NEXT_PUBLIC_SITE_URL=https://arjun902.github.io/arjun-neupane-academic-hub
# Local: leave blank. GitHub Pages CI supplies this automatically.
NEXT_PUBLIC_BASE_PATH=
# Leave blank until configured: protected routes fail closed.
NEXT_PUBLIC_SUPABASE_URL=
# A publishable (sb_publishable_...) or legacy anon key is accepted here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# NEVER put a service-role key in NEXT_PUBLIC_* variables.
# Edge Function secrets: SUPABASE_URL, SUPABASE_ANON_KEY,
# SUPABASE_SERVICE_ROLE_KEY (provided by Supabase), ALLOWED_ORIGIN.
