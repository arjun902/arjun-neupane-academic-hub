# Public academic site works without an environment file or backend.
NEXT_PUBLIC_SITE_URL=https://arjun902.github.io/arjun-neupane-academic-hub
# Blank for local development; GitHub Pages CI sets the project prefix.
NEXT_PUBLIC_BASE_PATH=
# Optional private admin only. Leave blank until a backend is configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never put service-role credentials, student data or passwords in NEXT_PUBLIC_*.
# Private backend secrets belong in the Supabase Edge Function environment.
