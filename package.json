{
  "name": "arjun-neupane-academic-hub",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify:export": "node scripts/verify-export.mjs",
    "check": "npm run typecheck && npm audit --omit=dev --audit-level=high",
    "test:policies": "node scripts/test-policies.mjs && node scripts/test-policies.mjs --legacy && node scripts/test-public-policies.mjs && node scripts/test-public-policies.mjs --legacy",
    "build:pages": "node scripts/build-pages.mjs",
    "typecheck:edge": "tsc -p supabase/functions/tsconfig.json",
    "doctor": "node scripts/doctor.mjs",
    "test:supabase:local": "node scripts/test-supabase-local.mjs",
    "test:content": "node scripts/test-content.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prettier": "^3.9.8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
